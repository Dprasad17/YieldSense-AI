# Copy to .env.docker (gitignored) and fill in. Used by docker compose --env-file .env.docker
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

APP_ENV=production
SECRET_KEY=
POSTGRES_PASSWORD=

# Public address of the site (used for CORS). With HTTPS: https://your.domain
PUBLIC_URL=http://localhost

# First start creates the schema and loads the reference dataset.
SEED_ON_START=true
# Demo accounts have published passwords: keep true for a demo, set false for a real deployment
# and create an administrator with: docker compose exec api python scripts/create_admin.py ...
SEED_DEMO_DATA=true

# API worker processes. More workers = more throughput; each keeps its own request metrics
# and sign-in rate limit, so use 1 if the admin metrics must cover all traffic.
API_WORKERS=2

# Optional AI text (rule-based fallback is used without it)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# API-wide limit per signed-in user or IP (requests per minute); 0 turns it off.
RATE_LIMIT_PER_MINUTE=600

# Optional integrations (empty = off). See docs/next-level-features.md.
# Google sign-in: OAuth client ID from Google Cloud Console (Web application)
GOOGLE_CLIENT_ID=
# Error tracking
SENTRY_DSN=
# Weekly digests: a scheduler calls POST /api/admin/digests/send with header X-Cron-Token
CRON_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Web port on the host. For HTTPS (--profile tls) set WEB_BIND=127.0.0.1 and WEB_PORT=8080, and DOMAIN.
WEB_BIND=0.0.0.0
WEB_PORT=80
DOMAIN=

# Registry images for docker-compose.prod.yml (set by the deploy workflow)
API_IMAGE=
WEB_IMAGE=
