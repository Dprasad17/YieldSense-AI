# Copy to deploy/huggingface/space.env (gitignored) and fill in. Used only by deploy_space.py.

# Hugging Face: a token with "Write" access (huggingface.co → Settings → Access Tokens)
HF_TOKEN=
# <your-hf-username>/<space-name>, e.g. durgaprasad/yieldsense-ai
HF_SPACE=
# true = only you can open it (evaluators would need a Hugging Face login); keep false for a demo
HF_PRIVATE=false

# Neon PostgreSQL connection string (Neon console → Connect), e.g.
# postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# MongoDB Atlas connection string (Atlas → Connect → Drivers), with your password filled in, e.g.
# mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=
MONGO_DB=yieldsense

# Leave empty to generate a random one
SECRET_KEY=

# Demo accounts with published passwords: true for the demo
SEED_DEMO_DATA=true

# Optional AI text
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
