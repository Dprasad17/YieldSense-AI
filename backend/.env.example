# YieldSense backend configuration. Copy to backend/.env and fill in.
# Real environment variables override this file; the repo-root .env is also read (GROQ_API_KEY).

# --- Security ---------------------------------------------------------------
# development | production. Production refuses to start without SECRET_KEY.
APP_ENV=development
# JWT signing secret, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Unset in development = random per process (everyone is signed out on restart).
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Browser origins allowed to call the API (comma-separated). Auth is a Bearer header, so
# CORS credentials are disabled.
CORS_ORIGINS=http://localhost:5173
# Failed sign-ins allowed per (IP, username) per window before HTTP 429.
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=60

# --- PostgreSQL (SQLAlchemy URL, psycopg 3 driver) ----------------------------
DATABASE_URL=postgresql+psycopg://yieldsense:CHANGE_ME@127.0.0.1:5432/yieldsense
# Separate database used by pytest (it is truncated and re-seeded on every run).
TEST_DATABASE_URL=postgresql+psycopg://yieldsense:CHANGE_ME@127.0.0.1:5432/yieldsense_test

# --- MongoDB -----------------------------------------------------------------
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=yieldsense
WEATHER_CACHE_SECONDS=1800

# --- Uploads (Data Collection) ------------------------------------------------
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_ROWS=50000

# --- Data and model ----------------------------------------------------------
# Reference CSV loaded by scripts/seed.py into crop_records.
DATASET_PATH=datasets/processed/cleaned_crop_yield.csv
MODEL_DIR=models/v2

# --- LLM (optional; rule-based fallback text is used when empty or failing) -----
# Put GROQ_API_KEY in the repo-root .env or here.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional second provider for prediction insights.
GEMINI_API_KEY=
