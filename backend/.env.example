# YieldSense backend configuration (read from the environment; the repo-root .env is also loaded for LLM keys)

# JWT signing secret. Set a long random value in production.
SECRET_KEY=change-me
# Session length in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Browser origins allowed to call the API, comma-separated. Auth uses a Bearer header,
# not cookies, so CORS credentials are disabled.
CORS_ORIGINS=http://localhost:5173

# Failed sign-ins allowed per (IP, username) per window before HTTP 429.
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=60

# Storage (paths relative to the repo root)
YIELDSENSE_DB_PATH=backend/data/app.db
# YIELDSENSE_USERS_FILE=backend/app/api/users_db.json

# Optional LLM for recommendation rationales and prediction insights (rule-based fallback when empty)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
